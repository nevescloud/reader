{
  // Reader website + internal API behind the mcp.neves.cloud gateway. No public
  // route: reachable only via the gateway's service binding. The MCP tools live
  // on the central mcp.neves.cloud/mcp server and drive us over /_api/*.
  //   Session — one per reader code; holds the current doc {v, html, title}, TTL alarm
  "name": "live-reader",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // No public route AND no workers.dev URL — reachable only via the gateway's
  // service binding, so mcp.neves.cloud/live-reader is the single entry.
  "workers_dev": false,

  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "Session" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Live", "Session"] },
    { "tag": "v2", "deleted_classes": ["Live"] }
  ],

  "observability": { "enabled": true }
}
