{
  // Reader website at neves.cloud/reader — a path-scoped route (see "routes" below)
  // intercepting /reader* in front of the GitHub Pages apex. Public surface
  // (/reader, /reader/<code>, /reader/s, /reader/c) is anonymous — an e-reader can't
  // OAuth, so the unguessable code is the capability. The write path /reader/_api/*
  // is gated by the READER_TOKEN secret (wrangler secret put). The reader_send tool
  // that holds the secret lives on the mcp.neves.cloud gateway (OAuth); it drives
  // us over /reader/_api/send.
  //   Session — one per reader code; holds the current doc {v, html, title}, TTL alarm
  "name": "reader",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // neves.cloud is a GitHub Pages org site (Cloudflare-proxied in front of it).
  // We do NOT own the hostname — a path-scoped route intercepts /reader* and runs
  // this Worker; every other path falls through to the Pages origin. (custom_domain
  // would seize the whole hostname and break Pages.) No workers.dev URL needed.
  "workers_dev": false,
  "routes": [
    { "pattern": "neves.cloud/reader*", "zone_name": "neves.cloud" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "Session" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Live", "Session"] },
    { "tag": "v2", "deleted_classes": ["Live"] }
  ],

  "observability": { "enabled": true }
}
