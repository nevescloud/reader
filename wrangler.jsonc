{
  // Reader website at reader.neves.cloud (custom_domain, served at root). Public
  // surface (the reader page, /s poll, /c tap, /w feed) is anonymous — an e-reader
  // can't OAuth, so the unguessable code is the capability. The write path /_api/*
  // is gated by the READER_TOKEN secret (wrangler secret put). The reader_send
  // tool that holds the secret lives on the mcp.neves.cloud gateway (OAuth) and
  // reaches us over a service binding at /_api/*.
  //   Session — one per reader code; holds the current doc {v, html, title}, TTL alarm
  "name": "reader",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Domain standard: this service owns its subdomain reader.neves.cloud via
  // custom_domain (wrangler provisions the proxied DNS record + cert on deploy).
  // custom_domain claims only that subdomain — the GitHub Pages apex is untouched.
  // No workers.dev URL needed.
  "workers_dev": false,
  "routes": [
    { "pattern": "reader.neves.cloud", "custom_domain": true }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "Session" },
      // ReaderMcp (agents/McpAgent) holds one Streamable-HTTP MCP session; the
      // anonymous /mcp endpoint serves through it and calls SESSION in-process.
      { "name": "READER_MCP", "class_name": "ReaderMcp" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Live", "Session"] },
    { "tag": "v2", "deleted_classes": ["Live"] },
    { "tag": "v3", "new_sqlite_classes": ["ReaderMcp"] }
  ],

  "observability": { "enabled": true }
}
