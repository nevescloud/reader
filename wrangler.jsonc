{
  // Anonymous MCP server + e-ink reader, mounted under /live-reader. No public
  // route: reachable only via the mcp.neves.cloud gateway's service binding, so
  // MCP + reader + poll all share one origin (mcp.neves.cloud) — no CORS.
  // Durable Objects:
  //   Live    — McpAgent, Streamable HTTP at /live-reader/mcp (no auth; isolates by code)
  //   Session — one per reader code; holds the current doc {v, html, title}, TTL alarm
  "name": "live-reader",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // No public route AND no workers.dev URL — reachable only via the gateway's
  // service binding, so mcp.neves.cloud/live-reader is the single entry.
  "workers_dev": false,

  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "Live" },
      { "name": "SESSION", "class_name": "Session" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Live", "Session"] }
  ],

  "observability": { "enabled": true }
}
